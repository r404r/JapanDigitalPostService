# Local full-stack manual-test configuration.
# These sample credentials and tokens are for local manual testing only.
# Do not reuse them in production or commit real secrets.

HTTP_ADDR=:8080
STATIC_DIR=/app/web

# Switch only these two values to change database dialect.
#
# SQLite default, persisted in the app-data Docker volume:
DB_DRIVER=sqlite
DB_DSN=file:/data/manual-test.db?cache=shared&_fk=1
#
# PostgreSQL service inside deployments/manual-test.compose.yml:
# DB_DRIVER=postgres
# DB_DSN=postgres://postal:postal@postgres:5432/postal?sslmode=disable
#
# MySQL service inside deployments/manual-test.compose.yml:
# DB_DRIVER=mysql
# DB_DSN=postal:postal@tcp(mysql:3306)/postal?parseTime=true&charset=utf8mb4

DB_CONNECT_TIMEOUT=5s
DB_MAX_RETRY=30
DB_RETRY_BACKOFF=1s

ADMIN_BOOTSTRAP_TOKEN=jdps_manual_admin_token
SEED_SAMPLE_DATA=true
SYNC_SCHEDULER_ENABLED=false
PAYLOAD_ENCRYPTION=none
