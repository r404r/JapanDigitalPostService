# 复制为 .env 用于本地开发。完整说明见 docs/architecture.md §9。

# HTTP
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# 数据库: postgres | mysql | sqlite（三方言均已接入，见 internal/store）
DB_DRIVER=sqlite
DB_DSN=file:dev.db?cache=shared&_fk=1
# addresses 表为空时是否写入内置示例数据，便于本地启动即可查询。
# 默认 false：同步引擎已落地，示例数据会使 auto 同步误判为 diff；仅本地开发按需开启。
SEED_SAMPLE_DATA=false
# 示例:
# DB_DRIVER=postgres
# DB_DSN=postgres://postal:postal@localhost:5432/postal?sslmode=disable
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=1h
# DB_DRIVER=mysql
# DB_DSN=postal:postal@tcp(localhost:3306)/postal?parseTime=true
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=1h
DB_CONNECT_TIMEOUT=5s
DB_MAX_RETRY=5
DB_RETRY_BACKOFF=500ms
# 连接池限制。sqlite 默认 1/1/0s；postgres/mysql 默认 25/10/1h。
DB_MAX_OPEN_CONNS=1
DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME=0s

# 同步
SYNC_CRON=0 3 * * *
SYNC_SCHEDULER_ENABLED=true
SYNC_FULL_URL=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_ken_all.zip
# 差分 add/del 模板（%s = YYMM，如 2605）。与全量同 base 路径。
SYNC_ADD_URL_TEMPLATE=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_add_%s.zip
SYNC_DEL_URL_TEMPLATE=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_del_%s.zip
SYNC_BATCH_SIZE=1000
SYNC_FULL_PRUNE=true
SYNC_FULL_MIN_ROWS=1000
SYNC_DIFF_FALLBACK_FULL=true
SYNC_DIFF_LOOKBACK_MONTHS=3
# 下载健壮性
DOWNLOAD_TIMEOUT=60s
DOWNLOAD_MAX_RETRY=3
DOWNLOAD_RETRY_BACKOFF=1s

# 查询
QUERY_TIMEOUT=2s
FUZZY_LIMIT=20
MAX_TOTAL=1000

# 认证（首个 admin token，引导用；启动时按 hash 幂等注入）
ADMIN_BOOTSTRAP_TOKEN=

# 传输加密: none | aes-gcm
# none = 仅 TLS（默认、推荐）。aes-gcm = 响应体 AES-256-GCM 应用层封装。
PAYLOAD_ENCRYPTION=none
# aes-gcm 模式必填：base64(标准) 编码的 32 字节(256-bit)密钥，仅从环境/KMS 注入，绝不入库。
# 生成示例: openssl rand -base64 32
PAYLOAD_ENC_KEY=
# 可选密钥标识，便于轮换（写入响应信封的 kid 字段）。
PAYLOAD_ENC_KEY_ID=
