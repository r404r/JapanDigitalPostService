# 复制为 .env 用于本地开发。完整说明见 docs/architecture.md §9。

# HTTP
HTTP_ADDR=:8080

# 数据库: postgres | mysql | sqlite
DB_DRIVER=sqlite
DB_DSN=file:dev.db?cache=shared&_fk=1
# 示例:
# DB_DRIVER=postgres
# DB_DSN=postgres://postal:postal@localhost:5432/postal?sslmode=disable
# DB_DRIVER=mysql
# DB_DSN=postal:postal@tcp(localhost:3306)/postal?parseTime=true
DB_CONNECT_TIMEOUT=5s
DB_MAX_RETRY=5
DB_RETRY_BACKOFF=500ms

# 同步
SYNC_CRON=0 3 * * *
SYNC_SCHEDULER_ENABLED=true
SYNC_FULL_URL=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_ken_all.zip
# 差分 add/del 模板（%s = YYMM，如 2605）。与全量同 base 路径。
SYNC_ADD_URL_TEMPLATE=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_add_%s.zip
SYNC_DEL_URL_TEMPLATE=https://www.post.japanpost.jp/service/search/zipcode/download/utf/zip/utf_del_%s.zip
SYNC_BATCH_SIZE=1000
SYNC_FULL_PRUNE=true
SYNC_FULL_MIN_ROWS=1000
SYNC_DIFF_FALLBACK_FULL=true
SYNC_DIFF_LOOKBACK_MONTHS=3
# 下载健壮性
DOWNLOAD_TIMEOUT=60s
DOWNLOAD_MAX_RETRY=3
DOWNLOAD_RETRY_BACKOFF=1s

# 查询
QUERY_TIMEOUT=2s
FUZZY_LIMIT=20
MAX_TOTAL=1000

# 认证（首个 admin token，引导用）
ADMIN_BOOTSTRAP_TOKEN=

# 传输加密: none | aes-gcm
PAYLOAD_ENCRYPTION=none
